# =============================================================================
# Molly Dashboard — environment configuration
#
# Copy this file to `.env.local` for local development. Everything here is
# NEXT_PUBLIC_ (read by the browser) and is a build-time default: the robot
# address, camera server and robot namespace can be changed at runtime in
# Settings, saved per browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Robot
# -----------------------------------------------------------------------------

# rosbridge_suite WebSocket endpoint (molly robot.launch.py web:=true).
# Must include ws:// or wss://. Use the robot's address in production:
#   NEXT_PUBLIC_ROSBRIDGE_URL=ws://192.168.1.120:9090
NEXT_PUBLIC_ROSBRIDGE_URL=ws://localhost:9090

# web_video_server HTTP base. The camera is requested at
# `${VIDEO_SERVER_URL}/stream?topic=/camera/camera/color/image_raw&type=mjpeg`.
NEXT_PUBLIC_VIDEO_SERVER_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# true: run against the in-memory mock robot even when rosbridge is reachable.
# Defaults to true in development and false in production builds; every build
# falls back to the mock robot while rosbridge is disconnected.
NEXT_PUBLIC_USE_MOCKS=true

# -----------------------------------------------------------------------------
# Ask Molly — LLM gateway (server side, never sent to the browser)
# -----------------------------------------------------------------------------

# Any OpenAI-compatible chat completions API: a base URL (…/v1) or the full
# …/chat/completions URL. Unset: the robot's own conversation node answers.
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional tuning (defaults shown)
# LLM_TEMPERATURE=0.5
# LLM_MAX_TOKENS=320
# LLM_TIMEOUT_MS=45000
# LLM_TIMEZONE=Asia/Jakarta
# Venue knowledge put in Molly's prompt, and extra instructions
# LLM_CONTEXT_FILE=config/assistant.md
# LLM_SYSTEM_PROMPT=

# Conversation history (conversations.jsonl)
# DATA_DIR=./data
