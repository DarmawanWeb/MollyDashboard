# Molly Dashboard deployment (docker-compose.yml). Copy to deploy/.env.

# Host port, in the Mac mini's 44x0 block: 4470 Molly, 4480 Taksu, 4490-4491 NETRA.
# Never 80, 8080, 3000 (Grafana), 3100 (Loki), 9090 (Prometheus) or 11434 (Ollama) there.
MOLLY_PORT=4470
# 127.0.0.1: only cloudflared reaches it. 0.0.0.0: also browsers on the LAN, needed to drive a
# real robot, because an https page cannot open the robot's plain ws:// rosbridge.
MOLLY_BIND=127.0.0.1

# Build-time defaults of the robot connection (also changeable per browser in Settings).
NEXT_PUBLIC_ROSBRIDGE_URL=ws://192.168.1.120:9090
NEXT_PUBLIC_VIDEO_SERVER_URL=http://192.168.1.120:8080
# true: always the mock robot (a public demo through the tunnel)
NEXT_PUBLIC_USE_MOCKS=false
